# Never commit real secrets.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Keep 0 until the business owner approves real pricing.
ESTIMATE_BASE_RATE=0
ESTIMATE_RATE_PER_SQM=0

# Optional business configuration path
BUSINESS_CONFIG_PATH=config/business.json
# Google Sheets webhook; configure only in hosting secrets after authorization
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
# WhatsApp remains disabled until explicit owner approval and official Cloud API setup
WHATSAPP_ENABLED=false

# Meta WhatsApp Cloud API — only for a customer-approved WhatsApp integration
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Shared secret between the customer app and Make/n8n
AUTOMATION_WEBHOOK_SECRET=
# Free-text AI processing is disabled by default because free text may contain PII.
# Set true only after an explicit privacy review; phone/email redaction is best-effort.
AI_ALLOW_FREE_TEXT=false
# Gemini API credentials belong in Make/n8n's encrypted credential store, not in this file.

# Business Studio -> Make.com approval webhook (leave unset until Make scenario is ready)
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_SECRET=
