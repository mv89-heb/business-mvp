# Never commit real secrets.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Keep 0 until the business owner approves real pricing.
ESTIMATE_BASE_RATE=0
ESTIMATE_RATE_PER_SQM=0

# Optional business configuration path
BUSINESS_CONFIG_PATH=config/business.json
# Google Sheets webhook; configure only in hosting secrets after authorization
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
# WhatsApp remains disabled until explicit owner approval and official Cloud API setup
WHATSAPP_ENABLED=false
